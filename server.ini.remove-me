; Notes:
; * You may use "<INIFILE>" in any path in order to refer to the folder the INI file lives in.
; * You may use "<TEMP>" in any path in order to refer to the temp folder of the current OS

home                = '<INIFILE>/'  ; "home" is a variable local to this INI file. Can be referenced in the sections with {home}

[CONFIG]
AppName             = 'Plodder'
DisplayRequests     = 0             ; 1 makes Rumba display every request in a ⎕ED windows. For debugging only of course.
LogHTTPToSession    = 0             ; Naturally only useful in development
MaxNoOfThreads      = 1000
HouseKeepingInterval= 5              ; In seconds
IdleConnectionTimeout=30             ; Close a connection idle for this long; only checked once per HouseKeepingInterval
Port                = 0             ; A 0 defaults to either 80 or 443, depending on "Secure"
Secure              = 0             ; If the port is 0 then "Secure" decides whether 80 or 443 is used
HTDOCS              = '{home}'      ; Becomes global G.HTDOCS: folder with static documents
;CongaFolder		= '/path2/conga'; Optional: when specified the folder must contain conga.dws and all required Conga DLLs
;CongaName          = 'DEFAULT'     ; Optional: the name of the Conga root
;TestFlag           = 0             ; Optional: 1 lets errors in AppLog surface. For testing only. The right argument of `Run` overrides it

[LOGGING]
Folder              = '<TEMP>/Plodder-Logs' ; Where the log file goes
Log                 = 1             ; app-log.txt: keep this 1, crash details go there (see "Crash storms" in the ReadMe). In production the others are most likely 0
LogHTTP             = 1             ; 0=off, 1=one line per request, 2=requests and responses in full, unmasked: for debugging only
LogConga            = 1 
LogRumba            = 1
WindowsEventLog     = ¯1                    ; Windows only! ¯1=Write Start/Stop/Error events to Windows Event Log in Runtime; 1=always ; 0=Never
;MaskIniKeys        = 'DBPASS'      ; Optional: more parts of key names whose values the start-up report masks, comma-separated

[CERTIFICATES]                      ; The following settings are ignored in case CONFIG.Secure is 0
PublicCertFile      = './Assets/Runtime/Certificates/myserver-cert.pem'
PrivateKeyFile      = './Assets/Runtime/Certificates/myserver-key.pem'
CertType            = 'DER'
;CA_Folder          = '/path2/CAs'  ; Optional: a folder with root (CA) certificates

[EVENTS]                            ; These are events used by Rumba to quit ⎕DQ or to broadcasts events ("Pause" and "Continue" when running as a Windows Service)
QuitEvent           = 9876
PauseEvent          = 9877
ContinueEvent       = 9878

[TRAP]
; Only one process may write to the TRAP folder: give every server instance a folder of its own.
Folder              = '<TEMP>/Plodder-Errors'   ; Where error information goes
Policy              = ¯1            ; ¯1 = Error trapping in Runtime but not otherwise. 1 = Trap; 0 = do not trap, not even in Runtime. General means "above" Rumba
Rumba               = 1             ; This has an effect only in development. Rumba traps all errors in Runtime in any case.
StormGuard          = 1             ; 1 = a recurring error gets the full crash report only at its 1st, 2nd, 4th, 8th... occurrence; 0 = always
StormCeiling        = 10            ; With StormGuard = 1: max number of full crash reports within one hour, all errors together
StormResetAfter     = 24            ; With StormGuard = 1: hours after which an error that has not occurred again counts from 1
SaveRequestBody     = 0             ; 1 = a crash report keeps request bodies (up to 64 KB). A body may carry anything, credentials included
;MaskHeaders        = 'X-My-Token'  ; Optional: more headers whose values are masked in crash reports, comma-separated
;MaskQueryParms     = 'session'     ; Optional: more query parameters whose values are masked in crash reports, comma-separated

[RIDE]
active              = 0
port                = 4502
address             = '*'           
wait                = 0             ; If 1 wait for the user in an endless loop

[APP]                                                  ; Change the following settings according to your needs:
Context             = '#.Plodder.SampleApp'            ; Where in the workspace does the application live?  (Ideally outside Plodder)
OnStart             = 'OnStart'                        ; Once called when the server starts
OnHeader            = 'OnHeader'                       ; Especially useful for handling "Expect" with value "100-continue"
OnRequest           = 'OnRequest'                      ; Called in the event of a request. Setting this is mandatory
OnCongaTimeout      = 'OnHouseKeeping'                 ; Housekeeping. Runs on the server loop thread, so start anything lengthy in a thread